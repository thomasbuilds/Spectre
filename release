#!/bin/bash

set -euo pipefail

die() {
  echo "error: $*" >&2
  exit 1
}

((BASH_VERSINFO[0] * 100 + BASH_VERSINFO[1] >= 501)) \
  || die "bash >= 5.1 required, older versions write the PIN here-string to a temporary file"
(($# == 1)) || die "usage: $0 <vX.Y.Z>"

normalize_fp() {
  local fp="${1//[[:space:]:]/}"
  echo "${fp,,}"
}

version_code() {
  local n='(0|[1-9][0-9]?)' ordinal=999
  [[ $1 =~ ^v$n\.$n\.$n(-(alpha|beta|rc)\.$n)?$ ]] \
    || die "invalid tag '$1', use vX.Y.Z or vX.Y.Z-(alpha|beta|rc).N with numbers 0-99"
  case ${BASH_REMATCH[5]} in
    alpha) ordinal=${BASH_REMATCH[6]} ;;
    beta) ordinal=$((100 + BASH_REMATCH[6])) ;;
    rc) ordinal=$((200 + BASH_REMATCH[6])) ;;
  esac
  echo $((BASH_REMATCH[1] * 10000000 + BASH_REMATCH[2] * 100000 + BASH_REMATCH[3] * 1000 + ordinal))
}

cd "$(dirname "$0")"

CERT_FILE="CERT.sha256"
GRADLE_FILE="app/build.gradle.kts"
PKCS11_LIB="/usr/lib/x86_64-linux-gnu/opensc-pkcs11.so"
[[ -f ${CERT_FILE} ]] || die "${CERT_FILE} missing, it pins the release key"
EXPECTED_CERT="$(normalize_fp "$(<"${CERT_FILE}")")"
[[ ${EXPECTED_CERT} =~ ^[0-9a-f]{64}$ ]] \
  || die "${CERT_FILE} does not hold a SHA-256 fingerprint"

TAG="$1"
VERSION_NAME="${TAG#v}"
VERSION_CODE="$(version_code "${TAG}")"

CHANGELOG="metadata/en-US/changelogs/${VERSION_CODE}.txt"
SOURCE_CODE="$(sed -nE 's/^[[:space:]]*versionCode = ([0-9]+)$/\1/p' "${GRADLE_FILE}")"
SOURCE_NAME="$(sed -nE 's/^[[:space:]]*versionName = "([^"]*)"$/\1/p' "${GRADLE_FILE}")"
if [[ ${SOURCE_CODE} != "${VERSION_CODE}" || ${SOURCE_NAME} != "${VERSION_NAME}" ]]; then
  TODO="versionCode = ${VERSION_CODE} and versionName = \"${VERSION_NAME}\""
  [[ ${VERSION_NAME} == *-* ]] || TODO+=" with ${CHANGELOG}"
  die "${GRADLE_FILE} is at ${SOURCE_NAME:-?} (${SOURCE_CODE:-?}), commit ${TODO} first"
fi
if [[ ${VERSION_NAME} != *-* ]]; then
  [[ -s ${CHANGELOG} ]] || die "missing ${CHANGELOG}, write and commit it first"
  (($(printf '%s' "$(<"${CHANGELOG}")" | LC_ALL=C.UTF-8 wc -m) <= 500)) \
    || die "${CHANGELOG} is over 500 characters, F-Droid cuts it off there"
fi

for tool in gh java keytool apksigcopier; do
  command -v "${tool}" >/dev/null || die "${tool} not found"
done
[[ -f ${PKCS11_LIB} ]] \
  || die "PKCS#11 module not found at ${PKCS11_LIB} (apt install opensc-pkcs11)"
[[ -z "$(git status --porcelain -unormal)" ]] || die "working tree not clean"
git fetch -q origin main
HEAD_SHA="$(git rev-parse HEAD)"
[[ ${HEAD_SHA} == "$(git rev-parse refs/remotes/origin/main)" ]] \
  || die "HEAD is not the tip of origin/main, push or pull first"
git rev-parse -q --verify "refs/tags/${TAG}" >/dev/null \
  && die "tag ${TAG} already exists locally"
REMOTE_TAGS="$(git ls-remote --tags --refs origin)" \
  || die "cannot list tags on origin"
HIGHEST_CODE=0
HIGHEST_TAG=""
while read -r _ REF; do
  CODE="$(version_code "${REF#refs/tags/}" 2>/dev/null)" || continue
  if ((CODE > HIGHEST_CODE)); then
    HIGHEST_CODE=${CODE}
    HIGHEST_TAG="${REF#refs/tags/}"
  fi
done <<<"${REMOTE_TAGS}"
((VERSION_CODE > HIGHEST_CODE)) \
  || die "versionCode ${VERSION_CODE} is not above ${HIGHEST_TAG} (${HIGHEST_CODE})"
CI_STATE="$(gh run list --commit "${HEAD_SHA}" --workflow ci.yml --event push \
  --json status,conclusion --jq '.[0] | if . == null then "missing"
    elif .status != "completed" then .status else .conclusion end')" \
  || die "cannot query CI runs"
[[ ${CI_STATE} == success ]] \
  || die "CI on ${HEAD_SHA:0:7} is ${CI_STATE}, release only a commit that passed"
gh release view "${TAG}" >/dev/null 2>&1 \
  && die "draft ${TAG} already exists, publish it or delete it: gh release delete ${TAG}"

SDK="${ANDROID_HOME:-${HOME}/Android/Sdk}"
BT="$(printf '%s\n' "${SDK}"/build-tools/* | grep -E '/(3[5-9]|[4-9][0-9])\.[0-9]+\.[0-9]+$' \
  | sort -V | tail -1)" \
  || die "no stable build-tools >= 35 under ${SDK}/build-tools, apksigner needs --alignment-preserved"
[[ -x "${BT}/zipalign" && -x "${BT}/apksigner" && -f "${BT}/lib/apksigner.jar" ]] \
  || die "zipalign/apksigner missing under ${BT}"

OUT="build/release"
NOTES="${OUT}/release-notes.md"
mkdir -p "${OUT}"
PKCS11_CFG="--name = OpenSC"$'\n'"library = ${PKCS11_LIB}"

pkcs11_token_present() {
  { echo | LC_ALL=C keytool -keystore NONE -storetype PKCS11 \
    -providerClass sun.security.pkcs11.SunPKCS11 -providerArg "${PKCS11_CFG}" \
    -list 2>&1 || true; } | grep -q 'Enter keystore password'
}
echo ">> Checking YubiKey access"
pkcs11_token_present || { sleep 2 && pkcs11_token_present; } \
  || die "YubiKey not visible via PKCS#11, replug it and retry"

echo ">> Building ${VERSION_NAME} (code ${VERSION_CODE}) at ${HEAD_SHA:0:7} from scratch"
./gradlew --no-build-cache :app:clean :app:assembleRelease
[[ -z "$(git status --porcelain -unormal)" && "$(git rev-parse HEAD)" == "${HEAD_SHA}" ]] \
  || die "the tree changed during the build, the APK may not match ${HEAD_SHA:0:7}"

UNSIGNED="app/build/outputs/apk/release/spectre-release-unsigned.apk"
SIGNED="${OUT}/spectre-${TAG}.apk"
[[ -f ${UNSIGNED} ]] || die "${UNSIGNED} missing, is archivesName still \"spectre\"?"
"${BT}/zipalign" -c -P 16 4 "${UNSIGNED}" || die "unsigned APK is not aligned"

IFS= read -rsp '>> Enter YubiKey PIN: ' YUBIKEY_PIN || die "no PIN entered"
echo

echo ">> Signing the APK with the YubiKey, please touch your device"
java --enable-native-access=ALL-UNNAMED \
  --add-exports jdk.crypto.cryptoki/sun.security.pkcs11=ALL-UNNAMED \
  -jar "${BT}/lib/apksigner.jar" sign \
  --ks NONE --ks-type PKCS11 \
  --provider-class sun.security.pkcs11.SunPKCS11 \
  --provider-arg "${PKCS11_CFG}" \
  --ks-key-alias "Certificate for Digital Signature" \
  --ks-pass stdin \
  --v1-signing-enabled false \
  --v4-signing-enabled false \
  --alignment-preserved \
  --out "${SIGNED}" "${UNSIGNED}" <<<"${YUBIKEY_PIN}" >/dev/null \
  || die "apksigner signing failed"

echo ">> Verifying signature"
VERIFY_OUT="$(java --enable-native-access=ALL-UNNAMED \
  -jar "${BT}/lib/apksigner.jar" verify --print-certs "${SIGNED}")" \
  || die "apksigner verify failed on ${SIGNED}"
GOT_NORM="$(normalize_fp "$(awk '/SHA-256 digest:/ {print $NF; exit}' <<<"${VERIFY_OUT}")")"
CERT_FMT=$(sed -E 's/(..)/\1:/g; s/:$//' <<<"${GOT_NORM^^}")
[[ ${GOT_NORM} == "${EXPECTED_CERT}" ]] \
  || die "signing certificate ${CERT_FMT} does not match ${CERT_FILE}"
echo "   Cert SHA-256 OK"

echo ">> Checking that F-Droid can reuse the signature"
ASC_OUT="$(PATH="${BT}:${PATH}" apksigcopier compare "${SIGNED}" \
  --unsigned "${UNSIGNED}" 2>&1)" \
  || die "F-Droid could not reuse this signature"$'\n'"${ASC_OUT}"

{
  cat "${CHANGELOG}" 2>/dev/null || echo "<!-- changelog -->"
  echo
  echo "SHA-256 signing certificate fingerprint:"
  echo "\`${CERT_FMT}\`"
} >"${NOTES}"

echo ">> Creating draft GitHub release for ${TAG}"
PRERELEASE_FLAG=()
[[ ${VERSION_NAME} != *-* ]] || PRERELEASE_FLAG=(--prerelease)
gh release create "${TAG}" --target "${HEAD_SHA}" \
  --title "Spectre ${TAG}" \
  --notes-file "${NOTES}" --draft "${PRERELEASE_FLAG[@]}" \
  "${SIGNED}"

echo
echo "Done: draft ${TAG}"
echo "Review the notes, then publish, which locks the tag and APK:"
echo "  gh release edit ${TAG} --draft=false"
